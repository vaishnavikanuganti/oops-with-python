class vehicle:
  brand="Toyota"
  model="Fortuner"
  def display_details(self):
    print("brand:",self.brand)
    print("model:",self.model)
class car(vehicle):
  doors=4
  colour="red"
  def display_car(self):
    print("Doors:", self.doors)
    print("colour:",self.colour)
class bike(vehicle):
  name="royalenfield"
  cc=125
  def display_bike(self):
    print("name:",self.name)
    print("cc:",self.cc)
    car=car()
    Bike=bike()

car.display_car()
Bike.display_bike()
  
